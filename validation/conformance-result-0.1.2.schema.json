{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/validation/0.1.2/conformance-result.schema.json",
  "title": "Non-normative Contract 0.1.1 corpus expected result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture",
    "base",
    "capabilities",
    "violations",
    "authoritativeClaimsStatus",
    "corpusVersion",
    "notTestedRequirementIds",
    "operationalStatus",
    "experimentalReporting"
  ],
  "properties": {
    "fixture": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_TESTED"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "NOT_CLAIMED",
          "PRESENT_EXPERIMENTAL",
          "NOT_NORMATIVELY_CERTIFIED",
          "NOT_TESTED",
          "UNKNOWN"
        ]
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "pattern": "^SPD-[A-Z0-9]+-[0-9]{3}$"
          },
          "resource": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authoritativeClaimsStatus": {
      "enum": [
        "KNOWN",
        "UNKNOWN"
      ]
    },
    "corpusVersion": {
      "const": "0.1.1"
    },
    "operationalStatus": {
      "enum": [
        "COMPLETE",
        "TOOL_UNAVAILABLE",
        "TOOL_ERROR",
        "RESOURCE_LIMIT",
        "MALFORMED_INPUT",
        "INTERNAL_ERROR",
        "SPEC_BLOCKER"
      ]
    },
    "notTestedRequirementIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SPD-[A-Z0-9]+-[0-9]{3}$"
      }
    },
    "experimentalReporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalFixedRenditionPresent",
        "fixedExperimentalCapabilityDeclared",
        "fixedExperimentalEvaluationStatus"
      ],
      "properties": {
        "physicalFixedRenditionPresent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fixedExperimentalCapabilityDeclared": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fixedExperimentalEvaluationStatus": {
          "enum": [
            "UNKNOWN",
            "NOT_TESTED",
            "NOT_CLAIMED"
          ]
        }
      }
    }
  }
}
