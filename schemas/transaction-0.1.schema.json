{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/semantic-fixed/transaction-0.1.schema.json",
  "title": "Minimal experimental transaction",
  "type": "object",
  "required": ["baseRevision", "operations"],
  "properties": {
    "baseRevision": {"type": "string", "pattern": "^r_"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "node"],
        "properties": {
          "op": {"enum": ["replaceText", "updateTableCell", "replaceFigure", "moveSection", "insertCitation"]},
          "node": {"type": "string", "pattern": "^n_"},
          "expectedNodeHash": {"type": "string"}
        }
      }
    }
  }
}

