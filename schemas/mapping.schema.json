{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spd/0.1/mapping.schema.json",
  "title": "SPD 0.1 semantic-to-fixed correspondence mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "revisionId", "fixedRendition", "provenance", "coordinateSystem", "pages", "records"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "documentId": {"$ref": "#/$defs/documentId"},
    "revisionId": {"$ref": "#/$defs/revisionId"},
    "fixedRendition": {
      "type": "object", "additionalProperties": false, "required": ["id", "sha256", "mediaType"],
      "properties": {
        "id": {"$ref": "#/$defs/fixedId"},
        "sha256": {"$ref": "#/$defs/digest"},
        "mediaType": {"type": "string", "minLength": 3}
      }
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "coordinateSystem": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "origin", "xDirection", "yDirection", "quadOrder"],
      "properties": {
        "unit": {"const": "css-px"},
        "origin": {"const": "top-left"},
        "xDirection": {"const": "right"},
        "yDirection": {"const": "down"},
        "quadOrder": {"const": "top-left,top-right,bottom-right,bottom-left"}
      }
    },
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "width", "height"],
        "properties": {
          "id": {"$ref": "#/$defs/pageId"},
          "width": {"type": "number", "exclusiveMinimum": 0},
          "height": {"type": "number", "exclusiveMinimum": 0},
          "toFixed": {"$ref": "#/$defs/matrix"}
        }
      }
    },
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "documentId": {"type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "revisionId": {"type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "nodeId": {"type": "string", "pattern": "^n_[a-z0-9._-]{1,128}$", "maxLength": 130},
    "fixedId": {"type": "string", "pattern": "^f_[a-z0-9._-]{1,128}$", "maxLength": 130},
    "pageId": {"type": "string", "pattern": "^p_[a-z0-9._-]{1,128}$", "maxLength": 130},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["method", "generator"],
      "properties": {
        "method": {"enum": ["forward-layout", "backward-recovery", "inferred", "manual"]},
        "generator": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "range": {
      "type": "object", "additionalProperties": false, "required": ["unit", "start", "end"],
      "properties": {
        "unit": {"const": "unicode-scalar-value"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "quad": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {"type": "number"}
    },
    "matrix": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"type": "number"}
    },
    "fragment": {
      "type": "object", "additionalProperties": false, "required": ["pageId", "quad"],
      "properties": {
        "pageId": {"$ref": "#/$defs/pageId"},
        "textRange": {"$ref": "#/$defs/range"},
        "quad": {"$ref": "#/$defs/quad"},
        "transform": {"$ref": "#/$defs/matrix"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "status", "provenance", "fragments"],
      "properties": {
        "nodeId": {"$ref": "#/$defs/nodeId"},
        "status": {"enum": ["MAPPED", "PARTIALLY_MAPPED", "NOT_VISIBLE", "UNMAPPABLE", "UNSUPPORTED"]},
        "provenance": {"$ref": "#/$defs/provenance"},
        "fragments": {"type": "array", "items": {"$ref": "#/$defs/fragment"}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "MAPPED"}}}, "then": {"properties": {"fragments": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "PARTIALLY_MAPPED"}}}, "then": {"required": ["reason"], "properties": {"fragments": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"enum": ["NOT_VISIBLE", "UNMAPPABLE", "UNSUPPORTED"]}}}, "then": {"required": ["reason"], "properties": {"fragments": {"maxItems": 0}}}}
      ]
    }
  }
}
