{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spd/0.1/document-state.schema.json",
  "title": "SPD 0.1 document and revision metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "revision", "semanticStateDigest", "renditionInputDigest", "capabilities"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "documentId": {"$ref": "#/$defs/documentId"},
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revisionId", "parents", "created", "generator"],
      "properties": {
        "revisionId": {"$ref": "#/$defs/revisionId"},
        "parents": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/revisionId"}},
        "created": {"type": "string", "format": "date-time"},
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 200},
            "version": {"type": "string", "minLength": 1, "maxLength": 100}
          }
        },
        "message": {"type": "string", "maxLength": 2000}
      }
    },
    "semanticStateDigest": {"$ref": "#/$defs/digest"},
    "renditionInputDigest": {"$ref": "#/$defs/digest"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {"properties": {"id": {"const": "Base"}}, "required": ["id"]},
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {"enum": ["Base", "Mapping", "Fixed-Experimental", "Accessible", "Archive-Experimental"]},
          "version": {"const": "0.1"}
        }
      }
    },
    "accessibilityTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epubAccessibility", "wcag"],
      "properties": {
        "epubAccessibility": {"const": "1.1"},
        "wcag": {"const": "2.2-AA"}
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "capabilities"],
        "properties": {
          "id": {"type": "string", "format": "uri"},
          "required": {"type": "boolean"},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"capabilities": {"contains": {"properties": {"id": {"const": "Accessible"}}, "required": ["id"]}}}},
      "then": {"required": ["accessibilityTarget"]}
    }
  ],
  "$defs": {
    "documentId": {"type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "revisionId": {"type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "nodeId": {"type": "string", "pattern": "^n_[a-z0-9._-]{1,128}$", "maxLength": 130},
    "fixedId": {"type": "string", "pattern": "^f_[a-z0-9._-]{1,128}$", "maxLength": 130},
    "pageId": {"type": "string", "pattern": "^p_[a-z0-9._-]{1,128}$", "maxLength": 130},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
