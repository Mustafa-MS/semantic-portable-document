{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "documentId": {
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "revisionId": {
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "urn:uuid:bbaefa13-a4ff-54bc-9a86-c5c4f586405c",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "documentId": {
      "$ref": "#/$defs/documentId"
    },
    "resources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "affects": {
            "items": {
              "enum": [
                "semantic",
                "rendering"
              ]
            },
            "maxItems": 2,
            "type": "array",
            "uniqueItems": true
          },
          "byteLength": {
            "minimum": 0,
            "type": "integer"
          },
          "mediaType": {
            "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;.*)?$",
            "type": "string"
          },
          "path": {
            "maxLength": 65535,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f]+$",
            "type": "string"
          },
          "role": {
            "enum": [
              "authoritative",
              "generated",
              "inferred",
              "cached",
              "non-normative",
              "control"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        },
        "required": [
          "path",
          "mediaType",
          "byteLength",
          "sha256",
          "role",
          "affects"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "revisionId": {
      "$ref": "#/$defs/revisionId"
    },
    "schemaVersion": {
      "const": "0.1"
    }
  },
  "required": [
    "schemaVersion",
    "documentId",
    "revisionId",
    "resources"
  ],
  "title": "SPD 0.1 normative resource inventory",
  "type": "object"
}
